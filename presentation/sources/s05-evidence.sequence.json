      "id": "spool",
      "type": "database",
      "label": "Browser spool",
      "sublabel": "IndexedDB",
      "explanation": "In-flight captures and one in-flight form. It turns 'Wi-Fi dropped, start again' into 'Wi-Fi dropped, carry on'. It is never the record."
    },
    {
      "id": "api",
      "type": "backend",
      "label": "Hub API",
      "sublabel": "Fastify"
    },
    {
      "id": "store",
      "type": "database",
      "label": "Record store",
      "sublabel": "SQLite, WAL",
      "explanation": "Steps, leases, evidence metadata, editions, amendments, audit and jobs. All SQL sits behind one repository module, so the v2 move to Postgres is a driver swap and one migration."
    },
    {
      "id": "evidence",
      "type": "database",
      "label": "Evidence store",
      "sublabel": "files by hash",
      "explanation": "Bytes named by their SHA-256, never inside the database. The original is authoritative and the 1000 px document copy is regenerable."
    }
  ],
