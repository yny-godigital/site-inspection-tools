  "cards": [
    {
      "dot": "cyan",
      "title": "One ingest path",
      "items": [
        "A site photo and a screenshot arrive the same way: bytes plus a client hash, hashed and stored by the Hub",
        "The adapter is not a second store, it calls the same evidence writer",
        "Two paths would mean two naming rules, two failure modes and a week of debugging"
      ]
    },
    {
      "dot": "amber",
      "title": "What the adapter owns",
      "items": [
        "Holds a FIFO queue and calls POST /capture one at a time",
        "Receives the POST, rejects an unknown or duplicate request id, hashes the bytes",
        "Times out, so a screenshot that never comes back becomes expired, not a wait"
      ]
    },
    {
      "dot": "rose",
      "title": "What keeps v2 cheap",
      "items": [
        "Client-generated ids and idempotent upserts, so a queued write can replay",
        "Images addressed by hash, so a resent photo is deduplicated",
        "Device id and per-device sequence on every write"
      ]
    }
  ]
