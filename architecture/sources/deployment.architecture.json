  "cards": [
    {
      "dot": "cyan",
      "title": "What runs where",
      "items": [
        "Tablet: a browser and nothing else, no install, no local database",
        "Hub: web server, API, SQLite records, evidence files, the approved xlsx template",
        "The only thing on the tablet is a spool for an in-flight form"
      ]
    },
    {
      "dot": "amber",
      "title": "Site constraints",
      "items": [
        "No internet. Wi-Fi is now load bearing, because capture writes straight to the Hub",
        "Camera access needs HTTPS, so the Hub serves TLS with a certificate the tablets trust",
        "Wi-Fi client isolation is unconfirmed with the network owner"
      ]
    },
    {
      "dot": "rose",
      "title": "Still open",
      "items": [
        "The tool exposes POST /capture and pushes the PNG back; if it cannot, a person attaches the file by hand",
        "Route from hub to the control network segment, fixed address and port in config"
      ]
    }
  ]
